# Copy this file to .env and adjust values
# The SECRET_KEY placeholder below is rejected at startup when DEBUG=False.
SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — pick one:
# SQLite (default, no extra setup)
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL
# DATABASE_URL=postgres://openzev:openzev@db:5432/openzev
# MariaDB (requires libmariadb-dev + mysqlclient pip package)
# DATABASE_URL=mysql://openzev:openzev@db:3306/openzev

# CORS — frontend origin(s)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Media files storage path
MEDIA_ROOT=/app/media

# Email (use console backend for dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=openzev@example.com

# Frontend base URL (used in verification emails and OAuth callback redirects)
FRONTEND_URL=http://localhost:5173

# Celery (async tasks for email sending)
CELERY_BROKER_URL=redis://localhost:6379/0

# Cache (e.g. geocoding results) — separate Redis DB from the Celery broker
CACHE_URL=redis://localhost:6379/1

# API keys — long-lived credentials users create for scripting against the API.
# Expiry applied when a key is created without an explicit one (0 = never).
API_KEY_DEFAULT_EXPIRY_DAYS=365
# Requests per key. Only key-authenticated traffic is throttled; browser
# sessions are not.
API_KEY_THROTTLE_RATE=600/hour
# How stale last_used_at may be before it is rewritten — bounds the write
# amplification of key authentication.
API_KEY_LAST_USED_RESOLUTION_MINUTES=5
