# Copy this file to .env and adjust values
# The SECRET_KEY placeholder below is rejected at startup when DEBUG=False.
SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — pick one:
# SQLite (default, no extra setup)
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL
# DATABASE_URL=postgres://openzev:openzev@db:5432/openzev
# MariaDB (requires libmariadb-dev + mysqlclient pip package)
# DATABASE_URL=mysql://openzev:openzev@db:3306/openzev

# CORS — frontend origin(s)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# CSRF — must match CORS for cookie CSRF when cross-origin; production same-origin needs no CORS
# CSRF_TRUSTED_ORIGINS defaults to CORS_ALLOWED_ORIGINS (set explicitly for https://app.example.com → https://api.example.com)
# CSRF_TRUSTED_ORIGINS=https://app.example.com

# Media files storage path
MEDIA_ROOT=/app/media

# Email (use console backend for dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Seconds before a stalled SMTP connection is abandoned (default 20).
# EMAIL_TIMEOUT=20
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=openzev@example.com

# Frontend base URL (used in verification emails and OAuth callback redirects)
FRONTEND_URL=http://localhost:5173

# Celery (async tasks for email sending)
CELERY_BROKER_URL=redis://localhost:6379/0

# Cache (e.g. geocoding results) — separate Redis DB from the Celery broker
CACHE_URL=redis://localhost:6379/1

# Async export jobs (ADR 0017): how long a completed export artifact is kept
# before the sweep deletes the file (metadata rows are retained), and the
# time budget for one export job before a stuck job is recovered to failed.
EXPORT_RETENTION_HOURS=24
EXPORT_RUNNER_TIMEOUT_S=1800

# API keys — long-lived credentials users create for scripting against the API.
# Expiry applied when a key is created without an explicit one (0 = never).
API_KEY_DEFAULT_EXPIRY_DAYS=365
# Requests per key. Only key-authenticated traffic is throttled; browser
# sessions are not.
API_KEY_THROTTLE_RATE=600/hour
# Per-IP rate limits for the public auth endpoints (login, refresh,
# registration, email verification, OAuth login/token exchange). Cookie
# sessions on the UI are not throttled by these.
AUTH_LOGIN_THROTTLE_RATE=40/hour
AUTH_REFRESH_THROTTLE_RATE=60/hour
AUTH_REGISTER_THROTTLE_RATE=10/hour
AUTH_VERIFY_THROTTLE_RATE=30/hour
AUTH_OAUTH_INITIATE_THROTTLE_RATE=60/hour
AUTH_OAUTH_EXCHANGE_THROTTLE_RATE=40/hour
# Per-ACCOUNT (not per-IP) budget on the MFA challenge exchange endpoint.
AUTH_MFA_THROTTLE_RATE=10/hour
# Per-account budget on asking to change the sign-in email (it checks the password).
AUTH_EMAIL_CHANGE_THROTTLE_RATE=5/hour
# Per-IP budget on the passkey sign-in ceremony.
AUTH_PASSKEY_THROTTLE_RATE=30/hour
# How stale last_used_at may be before it is rewritten — bounds the write
# amplification of key authentication.
API_KEY_LAST_USED_RESOLUTION_MINUTES=5

# Two-factor authentication (TOTP, ADR 0021): Fernet key(s) for encrypting the
# TOTP secret at rest. Deliberately separate from SECRET_KEY — rotating
# SECRET_KEY must never lock users out of their second factor. Comma-separate
# multiple keys to rotate (first encrypts, all decrypt); leave unset to keep
# MFA enrolment disabled. Generate one with:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MFA_ENCRYPTION_KEYS=

# Passkeys (WebAuthn): the relying-party identity must match what the browser
# sees. WEBAUTHN_RP_ID is the bare domain (no scheme or port), WEBAUTHN_ORIGIN
# the full origin the frontend is served from. Defaults suit local development.
# WEBAUTHN_RP_ID=zev.example.ch
# WEBAUTHN_RP_NAME=OpenZEV
# WEBAUTHN_ORIGIN=https://zev.example.ch

# Backups (docs/user-guide/18-backups.md). A backup holds password hashes,
# participants' personal data, invoices and the OAuth client secret, so encrypt
# it: set BACKUP_ENCRYPTION_KEYS (at least 32 characters each; comma-separate to
# rotate, first encrypts, all decrypt) and keep a copy of it OFF this server —
# without it an encrypted backup cannot be opened. Independent of
# MFA_ENCRYPTION_KEYS and SECRET_KEY. Generate one with:
#     python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# BACKUP_ENCRYPTION_KEYS=
# S3 credentials from the environment override any stored on a destination.
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# Where archives are assembled (needs room for one full archive); default: system temp.
# BACKUP_WORK_DIR=
# Safety backups (taken before restoring one community) expire after this many days; 0 keeps them.
# BACKUP_SAFETY_RETENTION_DAYS=30
