# Production values for self-hosting with docker-compose.yml or
# docker-compose.fullstack.yml: cp backend/.env.production.example backend/.env
DEBUG=False
SECRET_KEY=
# Public hostname(s) of this instance, comma-separated (no scheme, no port).
ALLOWED_HOSTS=
# Leave empty for same-origin deployments (nginx proxies /api/); otherwise comma-separated full origins.
CORS_ALLOWED_ORIGINS=
# CSRF origins, comma-separated full origins. Always set this to the public
# HTTPS origin (e.g. https://zev.example.ch) — even for same-origin deployments
# where CORS stays empty. Django sits behind the TLS-terminating proxy and only
# accepts the public origin here.
CSRF_TRUSTED_ORIGINS=
# Public base URL of the frontend (used in emails and redirects).
FRONTEND_URL=
# Passkey relying-party identity: the bare domain users open OpenZEV on.
WEBAUTHN_RP_ID=
# Passkey origin: the full origin the frontend is served from.
WEBAUTHN_ORIGIN=
# Fernet key(s) for TOTP secrets at rest, comma-separated (first encrypts, all decrypt).
MFA_ENCRYPTION_KEYS=
# Key(s) for backup artifacts and stored destination secrets, comma-separated (first encrypts, all decrypt).
BACKUP_ENCRYPTION_KEYS=
