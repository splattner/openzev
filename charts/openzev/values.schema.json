{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["debug"],
  "properties": {
    "debug": {
      "type": "boolean"
    },
    "backend": {
      "type": "object",
      "required": ["numProxies", "secureSslRedirect", "hstsSeconds"],
      "properties": {
        "numProxies": {
          "type": "integer",
          "minimum": 0
        },
        "secureSslRedirect": {
          "type": "boolean"
        },
        "hstsSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
