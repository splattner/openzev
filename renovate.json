{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":automergeMinor",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "labels": [
    "dependencies"
  ],
  "timezone": "Europe/Zurich",
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "automerge": false
    },
    {
      "matchManagers": ["npm"],
      "groupName": "frontend-npm"
    },
    {
      "matchManagers": ["pip_requirements"],
      "groupName": "backend-python"
    },
    {
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["scripts/site/requirements-docs.txt"],
      "groupName": "docs-site"
    },
    {
      "description": "Material for MkDocs does not support MkDocs 2.0 (plugin and theme systems were removed).",
      "matchManagers": ["pip_requirements"],
      "matchPackageNames": ["mkdocs"],
      "allowedVersions": "<2.0.0"
    },
    {
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major"]
    },
    {
      "description": "Transitive dep of django-celery-beat, which pins cron-descriptor<2.0.0. Bumping it makes requirements.txt unresolvable.",
      "matchManagers": ["pip_requirements"],
      "matchPackageNames": ["cron-descriptor"],
      "enabled": false
    },
    {
      "description": "django-celery-beat 2.9.0 requires Django<6.1. Remove once it supports Django 6.1.",
      "matchManagers": ["pip_requirements"],
      "matchPackageNames": ["Django"],
      "allowedVersions": "<6.1"
    },
    {
      "description": "botocore 1.44.1+ requires python-dateutil<3. Remove once botocore supports dateutil 4.",
      "matchManagers": ["pip_requirements"],
      "matchPackageNames": ["python-dateutil"],
      "allowedVersions": "<3.0.0"
    },
    {
      "description": "typescript-eslint has no TypeScript 7 support yet; TS7 crashes typescript-estree at lint time. Matched by dep name so the typescript-native alias (TS7, used for type-checking in npm run build) is not capped.",
      "matchManagers": ["npm"],
      "matchDepNames": ["typescript"],
      "allowedVersions": "<7.0.0"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on monday"]
  }
}
